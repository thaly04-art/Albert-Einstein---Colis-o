from manim import *

class Cena8ExemploCotidiano(Scene):
def construct(self):

    # ==========================================

    # 1. MESA DE BILHAR

    # ==========================================

    mesa_borda = Rectangle(

        width=10.4,

        height=5.4,

        color=WOOD_BROWN,

        stroke_width=12,

        fill_opacity=1

    )

    mesa_fundo = Rectangle(

        width=10,

        height=5,

        color=DARK_GREEN,

        fill_opacity=0.9,

        stroke_width=0

    )

    grupo_mesa = VGroup(mesa_borda, mesa_fundo)

    # ==========================================

    # 2. BOLAS DE BILHAR

    # ==========================================

    # Bola 1 - branca

    bola1 = Dot(

        point=LEFT * 3.8,

        radius=0.25,

        color=WHITE

    )

    num1 = Text(

        "1",

        font_size=16,

        color=BLACK

    ).move_to(bola1.get_center())

    grupo_bola1 = VGroup(bola1, num1)

    # Bola 2 - vermelha

    bola2 = Dot(

        point=ORIGIN,

        radius=0.25,

        color=RED

    )

    num2 = Text(

        "2",

        font_size=16,

        color=WHITE

    ).move_to(bola2.get_center())

    grupo_bola2 = VGroup(bola2, num2)

    # ==========================================

    # 3. TEXTO INFORMATIVO

    # ==========================================

    titulo_texto = Text(

        "Modelo ideal: colisão elástica",

        font_size=28,

        weight=BOLD,

        color=YELLOW

    )

    sub_texto = Paragraph(

        "Colisões macroscópicas reais geralmente não são perfeitamente elásticas,",

        "pois podem ocorrer perdas de energia para som, calor e deformações.",

        font_size=18,

        alignment="center",

        line_spacing=0.8

    )

    sub_texto.next_to(

        titulo_texto,

        DOWN,

        buff=0.2

    )

    caixa_texto = VGroup(

        titulo_texto,

        sub_texto

    )

    caixa_texto.to_edge(

        UP,

        buff=0.35

    )

    fundo_caixa = BackgroundRectangle(

        caixa_texto,

        color=BLACK,

        fill_opacity=0.85,

        buff=0.15

    )

    grupo_info_texto = VGroup(

        fundo_caixa,

        caixa_texto

    )

    # ==========================================

    # 4. ENTRADA DA CENA

    # ==========================================

    self.play(

        FadeIn(grupo_mesa),

        run_time=1.5

    )

    self.play(

        FadeIn(grupo_bola1),

        FadeIn(grupo_bola2),

        run_time=1

    )

    self.wait(0.8)

    # ==========================================

    # 5. APROXIMAÇÃO DA BOLA 1

    # ==========================================

    # A bola para a uma pequena distância da bola 2,

    # evitando sobreposição antes da colisão.

    ponto_colisao = LEFT * 0.5

    self.play(

        grupo_bola1.animate.move_to(ponto_colisao),

        run_time=2.5,

        rate_func=linear

    )

    # ==========================================

    # 6. EFEITO DE IMPACTO

    # ==========================================

    impacto = VGroup(

        Circle(

            radius=0.32,

            color=WHITE,

            stroke_width=4

        ),

        Circle(

            radius=0.18,

            color=YELLOW,

            stroke_width=3

        )

    )

    impacto.move_to(

        (grupo_bola1.get_center() + grupo_bola2.get_center()) / 2

    )

    # ==========================================

    # 7. COLISÃO

    # ==========================================

    # Depois da colisão, as bolas seguem em

    # direções diferentes.

    dest_bola1 = RIGHT * 1.8 + UP * 1.4

    dest_bola2 = RIGHT * 3.3 + DOWN * 0.9

    self.play(

        ShowPassingFlash(

            impacto,

            time_width=0.4,

            run_time=0.5

        ),

        grupo_bola1.animate.move_to(dest_bola1),

        grupo_bola2.animate.move_to(dest_bola2),

        run_time=2,

        rate_func=smooth

    )

    # ==========================================

    # 8. TEXTO EXPLICATIVO

    # ==========================================

    self.play(

        FadeIn(

            grupo_info_texto,

            shift=DOWN * 0.2

        ),

        run_time=1.2

    )

    # Tempo para a narração

    self.wait(11)

    # ==========================================

    # 9. SAÍDA

    # ==========================================

    self.play(

        FadeOut(grupo_info_texto),

        FadeOut(grupo_bola1),

        FadeOut(grupo_bola2),

        FadeOut(grupo_mesa),

        run_time=2

    )

    self.wait(0.5)
