from manim import *

class Cena9RelacaoEinstein(Scene):
    def construct(self):
        # ==========================================
        # 1. ELEMENTOS VISUAIS DA CENA 9
        # ==========================================

        # Fundo: Sala de Aula / Quadro Negro
        quadro = Rectangle(width=12, height=6.5, color=DARK_GRAY, fill_opacity=0.9)
        borda_quadro = Rectangle(width=12.4, height=6.9, color=WOOD_BROWN, stroke_width=10)
        grupo_quadro = VGroup(quadro, borda_quadro)

        # Representação Ilustrativa de Albert Einstein (Avatar/Boneco Simbólico)
        cabeca_einstein = Dot(point=ORIGIN, radius=0.6, color=WHITE)
        cabelo = AnnularSector(inner_radius=0.5, outer_radius=0.9, angle=PI, start_angle=0, color=LIGHT_GRAY)
        cabelo.move_to(cabeca_einstein.get_center() + UP * 0.2)
        bigode = CurvedArrow(start_point=LEFT * 0.25, end_point=RIGHT * 0.25, color=WHITE).move_to(cabeca_einstein.get_center() + DOWN * 0.2)
        corpo = Polygon(
            cabeca_einstein.get_center() + DOWN * 0.6 + LEFT * 0.8,
            cabeca_einstein.get_center() + DOWN * 0.6 + RIGHT * 0.8,
            cabeca_einstein.get_center() + DOWN * 2.2 + RIGHT * 1.2,
            cabeca_einstein.get_center() + DOWN * 2.2 + LEFT * 1.2,
            color=DARK_BLUE,
            fill_opacity=1
        )
        avatar_einstein = VGroup(corpo, cabeca_einstein, cabelo, bigode)
        avatar_einstein.move_to(LEFT * 3.5 + DOWN * 0.5)

        # Fórmulas de Física no Quadro (Clássica vs. Moderna)
        f_mecanica = MathTex(r"p = m \cdot v", font_size=32, color=GRAY_B)
        f_relatividade = MathTex(r"E = m \cdot c^2", font_size=40, color=YELLOW)
        f_momento_rel = MathTex(r"p = \gamma \cdot m \cdot v", font_size=32, color=GOLD_A)

        f_mecanica.move_to(RIGHT * 2.5 + UP * 2)
        f_relatividade.move_to(RIGHT * 2.5 + UP * 0.5)
        f_momento_rel.move_to(RIGHT * 2.5 + DOWN * 1)

        grupo_formulas = VGroup(f_mecanica, f_relatividade, f_momento_rel)

        # Breve Linha do Tempo da Física
        linha_tempo = Line(start=LEFT * 1, end=RIGHT * 5, color=WHITE).move_to(DOWN * 2.3)
        p1 = Dot(point=linha_tempo.get_start(), color=BLUE)
        p2 = Dot(point=linha_tempo.get_end(), color=YELLOW)
        
        lbl_p1 = Text("Física Clássica\n(Newton)", font_size=14, color=BLUE).next_to(p1, DOWN * 0.5)
        lbl_p2 = Text("Física Moderna\n(Einstein)", font_size=14, color=YELLOW).next_to(p2, DOWN * 0.5)

        grupo_linha = VGroup(linha_tempo, p1, p2, lbl_p1, lbl_p2)

        # ==========================================
        # 2. ANIMAÇÃO E TEMPO ESTIMADO (25–30 Segundos)
        # ==========================================

        # TRANSIÇÃO DE ENTRADA (Retorno da Cena 8)
        self.play(FadeIn(grupo_quadro), run_time=1.5)
