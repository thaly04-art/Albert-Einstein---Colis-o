from manim import *

class ConservacaoMomento(Scene):
    def construct(self):
        # --- 1. Elementos Visuais: Os Carrinhos ---
        carrinho1 = Rectangle(width=1.5, height=1.0, color=BLUE, fill_opacity=0.8)
        carrinho2 = Rectangle(width=1.5, height=1.0, color=RED, fill_opacity=0.8)
        
        # Posição logo após o toque no centro
        carrinho1.move_to(LEFT * 0.8)
        carrinho2.move_to(RIGHT * 0.8)
        
        m1 = MathTex("m_1", color=WHITE).move_to(carrinho1.get_center())
        m2 = MathTex("m_2", color=WHITE).move_to(carrinho2.get_center())
        
        grupo_c1 = VGroup(carrinho1, m1)
        grupo_c2 = VGroup(carrinho2, m2)
        
        self.play(FadeIn(grupo_c1), FadeIn(grupo_c2))

        # --- 2. Elementos Visuais: Novas Velocidades e Setas ---
        seta1 = Arrow(start=RIGHT * 0.7, end=LEFT * 0.7, color=BLUE).next_to(grupo_c1, UP, buff=0.15)
        seta2 = Arrow(start=LEFT * 0.7, end=RIGHT * 0.7, color=RED).next_to(grupo_c2, UP, buff=0.15)
        
        v1_text = MathTex("V_1'", color=BLUE).next_to(seta1, UP, buff=0.1)
        v2_text = MathTex("V_2'", color=RED).next_to(seta2, UP, buff=0.1)
        
        grupo_v1 = VGroup(seta1, v1_text)
        grupo_v2 = VGroup(seta2, v2_text)

        # Entrada suave dos vetores antes de iniciar o movimento
        self.play(GrowArrow(seta1), GrowArrow(seta2), FadeIn(v1_text), FadeIn(v2_text))

        # Ativação dos updaters para acompanhar os carrinhos
        grupo_v1.add_updater(lambda m: m.next_to(grupo_c1, UP, buff=0.15))
        grupo_v2.add_updater(lambda m: m.next_to(grupo_c2, UP, buff=0.15))

        # Os corpos se afastam
        self.play(
            grupo_c1.animate.shift(LEFT * 3),
            grupo_c2.animate.shift(RIGHT * 3),
            run_time=2,
            rate_func=linear
        )

        # Congela a posição das setas para evitar interferência na próxima etapa
        grupo_v1.clear_updaters()
        grupo_v2.clear_updaters()

        # --- 3. Aparição do Einstein ---
        einstein = Text("Einstein", font_size=36, color=YELLOW, weight=BOLD).to_edge(UP, buff=0.5)
        self.play(FadeIn(einstein))

        # Setas apontando do Einstein para os carrinhos já posicionados
        braco_apontando1 = Arrow(start=einstein.get_bottom(), end=grupo_c1.get_top() + UP * 0.3, color=YELLOW, buff=0.1)
        braco_apontando2 = Arrow(start=einstein.get_bottom(), end=grupo_c2.get_top() + UP * 0.3, color=YELLOW, buff=0.1)
        
        self.play(GrowArrow(braco_apontando1), GrowArrow(braco_apontando2))

        # --- 4. Comparação entre Momento Inicial e Final ---
        # Strings 'r' (raw string) evitam problemas de escape com LaTeX (\text)
        eq1 = MathTex(r"p_{\text{inicial}} = p_{\text{final}}", font_size=44)
        eq2 = MathTex(r"m_1 v_1 + m_2 v_2 = m_1 V_1' + m_2 V_2'", font_size=44)
        
        grupo_eq = VGroup(eq1, eq2).arrange(DOWN, buff=0.4).to_edge(DOWN, buff=0.7)
        caixa_eq = SurroundingRectangle(grupo_eq, color=WHITE, buff=0.25)

        self.play(Write(eq1))
        self.wait(0.5)
        self.play(Write(eq2))
        self.play(Create(caixa_eq))
        
        self.wait(3)


