from manim import *

class ColisaoEinstein(Scene):
    def construct(self):
        # 1. Configuração do Cenário
        chao = Line(LEFT * 7, RIGHT * 7, color=WHITE).shift(DOWN * 2)
        self.add(chao)

        # Função para criar os carrinhos
        def criar_carrinho(cor, texto, posicao_inicial):
            corpo = Rectangle(width=2, height=1, color=cor, fill_opacity=0.8)
            roda1 = Circle(radius=0.25, color=GRAY, fill_opacity=1).shift(DOWN * 0.5 + LEFT * 0.6)
            roda2 = Circle(radius=0.25, color=GRAY, fill_opacity=1).shift(DOWN * 0.5 + RIGHT * 0.6)
            label = MathTex(texto, color=WHITE).move_to(corpo.get_center())
            carrinho = VGroup(corpo, roda1, roda2, label)
            carrinho.move_to(posicao_inicial)
            return carrinho

        # Criando os carrinhos (largura 2, centros em x = -5 e x = +5)
        carrinho1 = criar_carrinho(BLUE, "m_1", LEFT * 5 + DOWN * 1.25)
        carrinho2 = criar_carrinho(RED, "m_2", RIGHT * 5 + DOWN * 1.25)

        # Setas de velocidade antes da colisão (v1 e v2)
        seta_v1 = Arrow(start=LEFT * 0.8, end=RIGHT * 0.8, color=YELLOW)
        seta_v2 = Arrow(start=RIGHT * 0.8, end=LEFT * 0.8, color=YELLOW)
        label_v1 = MathTex("v_1").next_to(seta_v1, UP, buff=0.1)
        label_v2 = MathTex("v_2").next_to(seta_v2, UP, buff=0.1)

        grupo_v1 = VGroup(seta_v1, label_v1).next_to(carrinho1, UP, buff=0.15)
        grupo_v2 = VGroup(seta_v2, label_v2).next_to(carrinho2, UP, buff=0.15)

        # Entrada inicial dos carrinhos e setas
        self.play(
            FadeIn(carrinho1),
            FadeIn(carrinho2),
            FadeIn(grupo_v1),
            FadeIn(grupo_v2)
        )

        # Ativa os updaters para as setas acompanharem o movimento
        grupo_v1.add_updater(lambda m: m.next_to(carrinho1, UP, buff=0.15))
        grupo_v2.add_updater(lambda m: m.next_to(carrinho2, UP, buff=0.15))

        # 2. Aproximação dos carrinhos (toque exato no centro x = 0)
        self.play(
            carrinho1.animate.shift(RIGHT * 4.0),
            carrinho2.animate.shift(LEFT * 4.0),
            run_time=2,
            rate_func=linear
        )

        # 3. Efeito visual no impacto
        ponto_impacto = carrinho1.get_right()
        impacto = Flash(ponto_impacto, color=YELLOW, line_length=0.5, num_lines=12)
        self.play(impacto)
        self.wait(0.5)

        # 4. Aparição do Einstein e Quadro Negro
        einstein = Tex("Albert Einstein", color=WHITE).scale(0.8).to_corner(UL)
        quadro = Rectangle(width=7.5, height=2.8, color=DARK_BROWN, fill_color=BLACK, fill_opacity=0.9)
        quadro.to_edge(UP, buff=0.5)

        self.play(FadeIn(quadro), Write(einstein))

        # 5. Equação da conservação do momento linear com cores mapeadas
        equacao = MathTex(
            "m_1", "v_1", "+", "m_2", "v_2", "=", "m_1", "v_1'", "+", "m_2", "v_2'",
            substrings_to_isolate=["m_1", "m_2"]
        ).move_to(quadro.get_center())

        equacao.set_color_by_tex("m_1", BLUE)
        equacao.set_color_by_tex("m_2", RED)

        self.play(Write(equacao), run_time=2.5)
        self.wait(2)

        # Ocultando quadro e removendo vetores antigos
        grupo_v1.clear_updaters()
        grupo_v2.clear_updaters()

        self.play(
            FadeOut(quadro),
            FadeOut(einstein),
            FadeOut(equacao),
            FadeOut(grupo_v1),
            FadeOut(grupo_v2)
        )

        # Novas setas de velocidade pós-colisão (v1' e v2')
        seta_v1_linha = Arrow(start=RIGHT * 0.8, end=LEFT * 0.8, color=GREEN)
        seta_v2_linha = Arrow(start=LEFT * 0.8, end=RIGHT * 0.8, color=GREEN)
        label_v1_linha = MathTex("v_1'").next_to(seta_v1_linha, UP, buff=0.1)
        label_v2_linha = MathTex("v_2'").next_to(seta_v2_linha, UP, buff=0.1)

        grupo_v1_linha = VGroup(seta_v1_linha, label_v1_linha).next_to(carrinho1, UP, buff=0.15)
        grupo_v2_linha = VGroup(seta_v2_linha, label_v2_linha).next_to(carrinho2, UP, buff=0.15)

        grupo_v1_linha.add_updater(lambda m: m.next_to(carrinho1, UP, buff=0.15))
        grupo_v2_linha.add_updater(lambda m: m.next_to(carrinho2, UP, buff=0.15))

        self.play(FadeIn(grupo_v1_linha), FadeIn(grupo_v2_linha))

        # 6. Afastamento dos carrinhos pós-colisão
        self.play(
            carrinho1.animate.shift(LEFT * 3.5),
            carrinho2.animate.shift(RIGHT * 3.5),
            run_time=2,
            rate_func=linear
        )

        self.wait(1)


